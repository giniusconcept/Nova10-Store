{
  "source": "NOVA10 Final",
  "shopifyPreset": "Horizon",
  "exportedThemeFileCount": 490,
  "compatibilityTarget": "independent-cloudflare-storefront",
  "parityTarget": "shopper-visible visual, motion and interaction parity",
  "runtimeVersion": "parity-runtime-1.0.0",
  "designTokens": {
    "pageWidth": "90rem",
    "background": "#ffffff",
    "foreground": "#000000",
    "color1": "#333333",
    "color2": "#DFDFDF",
    "bodyFont": "Inter 400",
    "subheadingFont": "Inter 500",
    "headingFont": "Inter 700",
    "h1": "56px",
    "h2": "48px",
    "primaryButtonRadius": 14,
    "secondaryButtonRadius": 14,
    "inputRadius": 4,
    "cartType": "drawer",
    "cardHoverEffect": "none"
  },
  "themeSettings": {
    "stickyHeader": "always",
    "announcementAutoplaySeconds": 5,
    "pageTransitionEnabled": false,
    "transitionToMainProduct": false,
    "cardHoverEffect": "none",
    "reducedMotionRespected": true
  },
  "motionConstants": {
    "fastMs": 62.5,
    "normalMs": 125,
    "mediumMs": 150,
    "slowMs": 200,
    "fadeIn": "cubic-bezier(.16,1,.3,1)",
    "fadeOut": "cubic-bezier(.4,0,.2,1)",
    "bounce": "cubic-bezier(.34,1.56,.64,1)"
  },
  "homepage": {
    "hero": {
      "height": "large",
      "images": ["nova10-crossbody.jpg", "nova10-gaming-controller.jpg"],
      "overlay": "gradient",
      "heading": "NOVA10 — le meilleur du moment, sans catalogue inutile."
    },
    "collections": ["beaute", "maison-outdoor", "tech-gaming", "lifestyle-voyage"],
    "productCollection": "top-10-nova10",
    "productColumnsDesktop": 4,
    "productColumnsMobile": 2
  },
  "runtimeModules": [
    "base-motion",
    "scroll-container",
    "scroll-restoration",
    "sticky-header",
    "drawer",
    "predictive-search",
    "product-grid-reveal",
    "product-card",
    "fly-to-cart",
    "media-zoom",
    "sticky-add-to-cart",
    "announcement-bar",
    "slideshow",
    "marquee",
    "focus-management",
    "view-transition-engine"
  ],
  "standardsApplied": [
    "safe-area-insets",
    "responsive-page-width",
    "shopify-horizon-section-heights",
    "focus-visible",
    "reduced-motion",
    "drawer-accessibility",
    "44px-touch-targets",
    "theme-button-tokens",
    "theme-input-tokens",
    "no-card-hover-effect"
  ]
}
